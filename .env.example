# AgriMarket - local development KHONG Docker
# Copy file nay thanh .env neu chua co:
#   Windows CMD: copy .env.example .env
#   PowerShell:  Copy-Item .env.example .env
#
# Ha tang local dung native services:
#   MySQL: 127.0.0.1:3306
#   Redis/Memurai: 127.0.0.1:6379
#
# Khong commit .env that.

TZ=Asia/Ho_Chi_Minh

# MySQL native
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agrimarket
MYSQL_USER=agrimarket
MYSQL_PASSWORD=agrimarket_local
MYSQL_ROOT_PASSWORD=agrimarket_root_local
DATABASE_URL=mysql://agrimarket:agrimarket_local@127.0.0.1:3306/agrimarket
SHADOW_DATABASE_URL=mysql://root:agrimarket_root_local@127.0.0.1:3306/agrimarket_shadow

# Redis / Memurai native
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=agrimarket:cache:
BULLMQ_PREFIX=agrimarket:bull
BULLMQ_ATTEMPTS=3
BULLMQ_BACKOFF_MS=1000

# S3-compatible local (optional; chi can khi dung upload/file)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=agrimarket
MINIO_ROOT_PASSWORD=agrimarket_minio_local
MINIO_BUCKET=agrimarket
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
FILE_SIGNED_URL_TTL_SECONDS=300

# SMTP local (optional; chi can khi test email)
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@agrimarket.local

# Frontend API / CORS
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3002,http://localhost:3002
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Mobile KHONG hard-code localhost cho dien thoai that.
# `pnpm dev:mobile` va `pnpm dev` tu dong lay LAN IP va inject bien nay.
# Chi dat tay khi muon override, vi du:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=agrimarket_refresh
REFRESH_COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30
CUSTOMER_WEB_URL=http://127.0.0.1:3001

# Payment Gateway - VNPay Sandbox
VNPAY_TMN_CODE=your-vnpay-sandbox-tmn-code
VNPAY_HASH_SECRET=your-vnpay-sandbox-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
PAYMENT_PUBLIC_BASE_URL=http://127.0.0.1:3000
MOBILE_PAYMENT_RETURN_URL=agrimarket://thanh-toan/ket-qua

# Optional Expo Push enhanced security token
EXPO_ACCESS_TOKEN=

# DEMO / LOCAL ONLY
DEMO_CUSTOMER_EMAIL=demo.customer@agrimarket.local
DEMO_CUSTOMER_PASSWORD=Demo-Customer-123
DEMO_ADMIN_EMAIL=demo.admin@agrimarket.local
DEMO_ADMIN_PASSWORD=Demo-Admin-123
