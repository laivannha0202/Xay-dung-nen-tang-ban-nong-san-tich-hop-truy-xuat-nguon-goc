# AgriMarket – biến môi trường mẫu cho local development
# Không commit .env thật. Docker Compose PHIEN-004 dùng local credential cố định để tránh bị biến shell ghi đè.
# docker-compose.yml có local default nên PHIEN-004 chạy được mà không cần tạo .env.

TZ=Asia/Ho_Chi_Minh

# MySQL
# Backend chạy trên host sẽ kết nối MySQL AgriMarket qua 127.0.0.1:3307.
MYSQL_IMAGE=mysql:8.4.11
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=agrimarket
MYSQL_USER=agrimarket
MYSQL_PASSWORD=agrimarket_local
MYSQL_ROOT_PASSWORD=agrimarket_root_local
DATABASE_URL=mysql://agrimarket:agrimarket_local@127.0.0.1:3307/agrimarket
# Chỉ dùng cho prisma migrate dev local; không dùng production.
SHADOW_DATABASE_URL=mysql://root:agrimarket_root_local@127.0.0.1:3307/agrimarket_shadow

# Redis
# Backend chạy trên host sẽ kết nối Redis AgriMarket qua 127.0.0.1:6380.
REDIS_IMAGE=redis:8.10.0-alpine
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
REDIS_PREFIX=agrimarket:cache:
BULLMQ_PREFIX=agrimarket:bull
BULLMQ_ATTEMPTS=3
BULLMQ_BACKOFF_MS=1000

# MinIO local
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=agrimarket
MINIO_ROOT_PASSWORD=agrimarket_minio_local
MINIO_BUCKET=agrimarket
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
FILE_SIGNED_URL_TTL_SECONDS=300

# Mailpit
MAILPIT_IMAGE=axllent/mailpit:v1.31.0
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@agrimarket.local

# Frontend API / CORS
# Customer Web dev: 3001; Admin Web dev: 3002.
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3002,http://localhost:3002
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# Mobile trên thiết bị thật phải thay bằng LAN IP của máy dev, ví dụ:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Auth PHIEN-012
# Production phải thay bằng secret ngẫu nhiên đủ mạnh và quản lý ngoài source code.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=agrimarket_refresh
REFRESH_COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30
CUSTOMER_WEB_URL=http://127.0.0.1:3001

# Payment Gateway PHIEN-055 – VNPay Sandbox
# Lấy credential sandbox riêng của merchant; không commit secret thật.
VNPAY_TMN_CODE=your-vnpay-sandbox-tmn-code
VNPAY_HASH_SECRET=your-vnpay-sandbox-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
