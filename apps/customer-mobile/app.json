{
  "expo": {
    "name": "AgriMarket",
    "slug": "agrimarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#2f6b3d",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Dùng camera để quét tem QR truy xuất nguồn gốc lô hàng."
      }
    },
    "android": {
      "package": "vn.agrimarket.app",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBase": "http://127.0.0.1:4000/api/v1",
      "webBase": "http://127.0.0.1:3000"
    }
  }
}
