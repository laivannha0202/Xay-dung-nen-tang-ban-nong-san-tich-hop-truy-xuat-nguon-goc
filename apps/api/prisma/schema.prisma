  kho              Kho              @relation(fields: [khoId], references: [id], onDelete: Restrict, map: "fk_inventory_lot_warehouse")
  loSanPham        LoSanPham        @relation(fields: [loSanPhamId], references: [id], onDelete: Restrict, map: "fk_inventory_lot_batch")
  bienTheSanPham   BienTheSanPham   @relation(fields: [bienTheSanPhamId], references: [id], onDelete: Restrict, map: "fk_inventory_lot_variant")
  giaoDich         GiaoDichTonKho[]

  mucDatChoTonKho MucDatChoTonKho[]

  phanBoDonHang PhanBoDonHang[]

  @@unique([khoId, loSanPhamId, bienTheSanPhamId], map: "uk_inventory_lot_warehouse_batch_variant")
  @@index([khoId], map: "idx_inventory_lot_warehouse")
  @@index([loSanPhamId], map: "idx_inventory_lot_batch")
  @@index([bienTheSanPhamId], map: "idx_inventory_lot_variant")
  @@map("inventory_lot")
}

enum TrangThaiDonHang {
  CHO_THANH_TOAN
  DA_XAC_NHAN
  DANG_CHUAN_BI
  DA_DONG_GOI
  DANG_GIAO
  DA_GIAO
  HOAN_THANH
  DA_HUY
  KHIEU_NAI
  HOAN_TIEN_MOT_PHAN
  HOAN_TIEN_TOAN_BO
}

model DonHang {
  id            String              @id @default(uuid(7)) @db.Char(36)
  maDonHang     String              @unique(map: "uk_order_number") @map("ma_don_hang") @db.VarChar(100)
  khachHangId   String              @map("khach_hang_id") @db.Char(36)
  trangThai     TrangThaiDonHang    @default(CHO_THANH_TOAN) @map("trang_thai")
  tongTien      Decimal             @map("tong_tien") @db.Decimal(15, 2)
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  khachHang     KhachHang           @relation(fields: [khachHangId], references: [id], onDelete: Restrict, map: "fk_order_customer")
  donNhaCungCap DonHangNhaCungCap[]

  thanhToan ThanhToan[]

  @@index([khachHangId, createdAt], map: "idx_order_customer_created_at")
  @@index([trangThai, createdAt], map: "idx_order_status_created_at")
  @@map("order")
}

model DonHangNhaCungCap {
  id           String           @id @default(uuid(7)) @db.Char(36)
  maDon        String           @unique(map: "uk_supplier_order_number") @map("ma_don") @db.VarChar(100)
  donHangId    String           @map("don_hang_id") @db.Char(36)
  nhaCungCapId String           @map("nha_cung_cap_id") @db.Char(36)
  trangThai    TrangThaiDonHang @default(CHO_THANH_TOAN) @map("trang_thai")
  tamTinh      Decimal          @map("tam_tinh") @db.Decimal(15, 2)
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  donHang      DonHang          @relation(fields: [donHangId], references: [id], onDelete: Restrict, map: "fk_supplier_order_order")
  nhaCungCap   NhaCungCap       @relation(fields: [nhaCungCapId], references: [id], onDelete: Restrict, map: "fk_supplier_order_supplier")
  muc          MucDonHang[]
  vanChuyen    VanChuyen[]

  @@unique([donHangId, nhaCungCapId], map: "uk_supplier_order_order_supplier")
  @@index([nhaCungCapId, trangThai, createdAt], map: "idx_supplier_order_supplier_status")
  @@index([donHangId, createdAt], map: "idx_supplier_order_order")
  @@map("supplier_order")
}

model MucDonHang {
  id                       String            @id @default(uuid(7)) @db.Char(36)
  donHangNhaCungCapId      String            @map("don_hang_nha_cung_cap_id") @db.Char(36)
  sanPhamId                String            @map("san_pham_id") @db.Char(36)
  bienTheSanPhamId         String            @map("bien_the_san_pham_id") @db.Char(36)
  trangTraiId              String            @map("trang_trai_id") @db.Char(36)
  soLuong                  Int               @map("so_luong") @db.UnsignedInt
  donGiaSnapshot           Decimal           @map("don_gia_snapshot") @db.Decimal(15, 2)
  tenSanPhamSnapshot       String            @map("ten_san_pham_snapshot") @db.VarChar(200)
  skuBienTheSnapshot       String            @map("sku_bien_the_snapshot") @db.VarChar(100)
  khoiLuongBienTheSnapshot Decimal           @map("khoi_luong_bien_the_snapshot") @db.Decimal(12, 3)
  donViBienTheSnapshot     String            @map("don_vi_bien_the_snapshot") @db.VarChar(30)
  maTrangTraiSnapshot      String            @map("ma_trang_trai_snapshot") @db.VarChar(50)
  tenTrangTraiSnapshot     String            @map("ten_trang_trai_snapshot") @db.VarChar(200)
  createdAt                DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  donHangNhaCungCap        DonHangNhaCungCap @relation(fields: [donHangNhaCungCapId], references: [id], onDelete: Restrict, map: "fk_order_item_supplier_order")
  sanPham                  SanPham           @relation(fields: [sanPhamId], references: [id], onDelete: Restrict, map: "fk_order_item_product")
  bienTheSanPham           BienTheSanPham    @relation(fields: [bienTheSanPhamId], references: [id], onDelete: Restrict, map: "fk_order_item_variant")
  trangTrai                TrangTrai         @relation(fields: [trangTraiId], references: [id], onDelete: Restrict, map: "fk_order_item_farm")
  phanBo                   PhanBoDonHang[]
  danhGia                  DanhGia?
  khieuNai                 KhieuNai[]

  @@unique([donHangNhaCungCapId, bienTheSanPhamId], map: "uk_order_item_supplier_order_variant")
  @@index([sanPhamId], map: "idx_order_item_product")
  @@index([bienTheSanPhamId], map: "idx_order_item_variant")
  @@index([trangTraiId], map: "idx_order_item_farm")
  @@map("order_item")
}

model DanhGia {
  id           String     @id @default(uuid(7)) @db.Char(36)
  mucDonHangId String     @unique(map: "uk_review_order_item") @map("order_item_id") @db.Char(36)
  diem         Int        @map("rating") @db.TinyInt
  binhLuan     String?    @map("comment") @db.VarChar(2000)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  mucDonHang   MucDonHang @relation(fields: [mucDonHangId], references: [id], onDelete: Restrict, map: "fk_review_order_item")

  @@index([diem, createdAt], map: "idx_review_rating_created_at")
  @@map("review")
}

enum LyDoKhieuNai {
  HONG
  DAP
  SAI
  THIEU
  HET_HAN
  CHAT_LUONG
  CHUNG_NHAN
}

model KhieuNai {
  id           String              @id @default(uuid(7)) @db.Char(36)
  mucDonHangId String              @map("order_item_id") @db.Char(36)
  lyDo         LyDoKhieuNai        @map("reason")
  moTa         String              @map("description") @db.VarChar(2000)
  createdAt    DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  mucDonHang   MucDonHang          @relation(fields: [mucDonHangId], references: [id], onDelete: Restrict, map: "fk_complaint_order_item")
  bangChung    KhieuNaiBangChung[]

  @@index([mucDonHangId, createdAt], map: "idx_complaint_order_item_created_at")
  @@index([lyDo, createdAt], map: "idx_complaint_reason_created_at")
  @@map("complaint")
}

model KhieuNaiBangChung {
  id         String   @id @default(uuid(7)) @db.Char(36)
  khieuNaiId String   @map("complaint_id") @db.Char(36)
  tepTinId   String   @map("file_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  khieuNai   KhieuNai @relation(fields: [khieuNaiId], references: [id], onDelete: Restrict, map: "fk_complaint_evidence_complaint")
  tepTin     TepTin   @relation(fields: [tepTinId], references: [id], onDelete: Restrict, map: "fk_complaint_evidence_file")

  @@unique([khieuNaiId, tepTinId], map: "uk_complaint_evidence_complaint_file")
  @@index([tepTinId], map: "idx_complaint_evidence_file")
  @@map("complaint_evidence")
}

model PhanBoDonHang {
  id           String     @id @default(uuid(7)) @db.Char(36)
  mucDonHangId String     @map("muc_don_hang_id") @db.Char(36)
  tonKhoLoId   String     @map("ton_kho_lo_id") @db.Char(36)
  soLuong      Decimal    @map("so_luong") @db.Decimal(14, 3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  mucDonHang   MucDonHang @relation(fields: [mucDonHangId], references: [id], onDelete: Restrict, map: "fk_order_allocation_order_item")
  tonKhoLo     TonKhoLo   @relation(fields: [tonKhoLoId], references: [id], onDelete: Restrict, map: "fk_order_allocation_inventory_lot")

  @@unique([mucDonHangId, tonKhoLoId], map: "uk_order_allocation_item_lot")
  @@index([tonKhoLoId], map: "idx_order_allocation_inventory_lot")
  @@map("order_allocation")
}

enum TrangThaiThanhToan {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

model ThanhToan {
  id         String              @id @default(uuid(7)) @db.Char(36)
  donHangId  String              @map("don_hang_id") @db.Char(36)
  soTien     Decimal             @map("so_tien") @db.Decimal(15, 2)
  phuongThuc String              @map("phuong_thuc") @db.VarChar(50)
  trangThai  TrangThaiThanhToan  @default(CREATED) @map("trang_thai")
  createdAt  DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  donHang    DonHang             @relation(fields: [donHangId], references: [id], onDelete: Restrict, map: "fk_payment_order")
  giaoDich   GiaoDichThanhToan[]

  @@index([donHangId, createdAt], map: "idx_payment_order_created_at")
  @@index([trangThai, createdAt], map: "idx_payment_status_created_at")
  @@index([phuongThuc, trangThai], map: "idx_payment_method_status")
  @@map("payment")
}

model GiaoDichThanhToan {
  id          String             @id @default(uuid(7)) @db.Char(36)
  thanhToanId String             @map("thanh_toan_id") @db.Char(36)
  maGiaoDich  String             @unique(map: "uk_payment_transaction_code") @map("ma_giao_dich") @db.VarChar(191)
  soTien      Decimal            @map("so_tien") @db.Decimal(15, 2)
  phuongThuc  String             @map("phuong_thuc") @db.VarChar(50)
  trangThai   TrangThaiThanhToan @map("trang_thai")
  thoiGian    DateTime           @default(now()) @map("thoi_gian") @db.DateTime(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  thanhToan   ThanhToan          @relation(fields: [thanhToanId], references: [id], onDelete: Restrict, map: "fk_payment_transaction_payment")

  @@index([thanhToanId, thoiGian], map: "idx_payment_transaction_payment_time")
  @@index([trangThai, thoiGian], map: "idx_payment_transaction_status_time")
  @@index([phuongThuc, thoiGian], map: "idx_payment_transaction_method_time")
  @@map("payment_transaction")
}

enum TrangThaiVanChuyen {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model VanChuyen {
  id                  String                   @id @default(uuid(7)) @db.Char(36)
  donHangNhaCungCapId String                   @map("don_hang_nha_cung_cap_id") @db.Char(36)
  maVanDon            String                   @unique(map: "uk_shipment_tracking_number") @map("ma_van_don") @db.VarChar(191)
  trangThai           TrangThaiVanChuyen       @default(CREATED) @map("trang_thai")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  donHangNhaCungCap   DonHangNhaCungCap        @relation(fields: [donHangNhaCungCapId], references: [id], onDelete: Restrict, map: "fk_shipment_supplier_order")
  suKien              SuKienTheoDoiVanChuyen[]

  @@index([donHangNhaCungCapId, createdAt], map: "idx_shipment_supplier_order_created_at")
  @@index([trangThai, createdAt], map: "idx_shipment_status_created_at")
  @@map("shipment")
}

model SuKienTheoDoiVanChuyen {
  id          String             @id @default(uuid(7)) @db.Char(36)
  vanChuyenId String             @map("van_chuyen_id") @db.Char(36)
  trangThai   TrangThaiVanChuyen @map("trang_thai")
  moTa        String?            @map("mo_ta") @db.VarChar(255)
  viTri       String?            @map("vi_tri") @db.VarChar(255)
  thoiGian    DateTime           @default(now()) @map("thoi_gian") @db.DateTime(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  vanChuyen   VanChuyen          @relation(fields: [vanChuyenId], references: [id], onDelete: Restrict, map: "fk_tracking_event_shipment")

  @@index([vanChuyenId, thoiGian], map: "idx_tracking_event_shipment_time")
  @@index([trangThai, thoiGian], map: "idx_tracking_event_status_time")
  @@map("tracking_event")
}

enum TrangThaiDatChoTonKho {
  DANG_GIU
  DA_BAN
  DA_GIAI_PHONG
  HET_HAN
}

enum LoaiGiaoDichTonKho {
  HARVEST_IN
  TRANSFER_IN
  TRANSFER_OUT
  ORDER_RESERVE
  ORDER_RELEASE
  ORDER_SHIP
  RETURN_IN
  DAMAGE
  EXPIRE
  ADJUSTMENT
}

model DatChoTonKho {
  id          String                @id @default(uuid(7)) @db.Char(36)
  maThamChieu String                @unique(map: "uk_inventory_reservation_reference") @map("ma_tham_chieu") @db.VarChar(191)
  trangThai   TrangThaiDatChoTonKho @default(DANG_GIU) @map("trang_thai")
  hetHanLuc   DateTime              @map("het_han_luc") @db.DateTime(3)
  ketThucLuc  DateTime?             @map("ket_thuc_luc") @db.DateTime(3)
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  muc         MucDatChoTonKho[]

  @@index([trangThai, hetHanLuc], map: "idx_inventory_reservation_status_expiry")
  @@map("inventory_reservation")
}

model MucDatChoTonKho {
  id             String       @id @default(uuid(7)) @db.Char(36)
  datChoTonKhoId String       @map("dat_cho_ton_kho_id") @db.Char(36)
  tonKhoLoId     String       @map("ton_kho_lo_id") @db.Char(36)
  soLuong        Decimal      @map("so_luong") @db.Decimal(14, 3)
  thuTu          Int          @map("thu_tu") @db.UnsignedInt
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  datChoTonKho   DatChoTonKho @relation(fields: [datChoTonKhoId], references: [id], onDelete: Cascade, map: "fk_inventory_reservation_item_reservation")
  tonKhoLo       TonKhoLo     @relation(fields: [tonKhoLoId], references: [id], onDelete: Restrict, map: "fk_inventory_reservation_item_inventory_lot")

  @@unique([datChoTonKhoId, tonKhoLoId], map: "uk_inventory_reservation_item_lot")
  @@index([tonKhoLoId], map: "idx_inventory_reservation_item_inventory_lot")
  @@map("inventory_reservation_item")
}

model GiaoDichTonKho {
  id         String             @id @default(uuid(7)) @db.Char(36)
  tonKhoLoId String             @map("ton_kho_lo_id") @db.Char(36)
  loai       LoaiGiaoDichTonKho
  soLuong    Decimal            @map("so_luong") @db.Decimal(14, 3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  tonKhoLo   TonKhoLo           @relation(fields: [tonKhoLoId], references: [id], onDelete: Restrict, map: "fk_inventory_transaction_inventory_lot")

  @@index([tonKhoLoId, createdAt], map: "idx_inventory_transaction_lot_created_at")
  @@index([loai, createdAt], map: "idx_inventory_transaction_type_created_at")
  @@map("inventory_transaction")
}

model CauHinhHeThong {
  id                  Int      @id @default(1)
  reservationTtlPhut  Int      @default(15) @map("reservation_ttl_minutes") @db.UnsignedInt
  thoiHanKhieuNaiNgay Int      @default(7) @map("complaint_window_days") @db.UnsignedInt
  nguongSapHetHanNgay Int      @default(7) @map("near_expiry_threshold_days") @db.UnsignedInt
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("system_settings")
}
