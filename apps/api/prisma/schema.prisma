generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

enum TrangThaiNguoiDung {
  CHUA_KICH_HOAT
  HOAT_DONG
  TAM_KHOA
}

enum TrangThaiBanGhi {
  HOAT_DONG
  NGUNG_HOAT_DONG
}

enum TrangThaiXacMinhChungNhan {
  CHO_XAC_MINH
  DA_XAC_MINH
  TU_CHOI
}

enum TrangThaiMuaVu {
  KE_HOACH
  DANG_CANH_TAC
  CHO_THU_HOACH
  DA_KET_THUC
  HUY
}

enum LoaiSuKienCanhTac {
  TUOI
  BON_PHAN
  SAU_BENH
  KIEM_TRA
  THOI_TIET
  KHAC
}

enum TrangThaiLoSanPham {
  MOI_TAO
  CHO_KIEM_DINH
  CO_THE_BAN
  TAM_GIU
  KHONG_DAT
  THU_HOI
  HET_HANG
}

enum KetQuaKiemDinhChatLuong {
  PASSED
  FAILED
  HOLD
  RECALLED
}

model NguoiDung {
  id                  String                @id @default(uuid(7)) @db.Char(36)
  email               String                @unique(map: "uk_nguoi_dung_email") @db.VarChar(191)
  soDienThoai         String?               @unique(map: "uk_nguoi_dung_so_dien_thoai") @map("so_dien_thoai") @db.VarChar(20)
  matKhauHash         String                @map("mat_khau_hash") @db.VarChar(255)
  hoTen               String                @map("ho_ten") @db.VarChar(150)
  trangThai           TrangThaiNguoiDung    @default(CHUA_KICH_HOAT) @map("trang_thai")
  createdAt           DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  khachHang           KhachHang?
  nhanVien            NhanVien?
  diaChi              DiaChi[]
  nguoiDungVaiTro     NguoiDungVaiTro[]
  phienDangNhap       PhienDangNhap[]
  yeuCauDatLaiMatKhau YeuCauDatLaiMatKhau[]
  kiemDinhChatLuong   KiemDinhChatLuong[]

  @@index([trangThai], map: "idx_nguoi_dung_trang_thai")
  @@map("nguoi_dung")
}

model KhachHang {
  id          String          @id @default(uuid(7)) @db.Char(36)
  nguoiDungId String          @unique(map: "uk_khach_hang_nguoi_dung") @map("nguoi_dung_id") @db.Char(36)
  ngaySinh    DateTime?       @map("ngay_sinh") @db.Date
  trangThai   TrangThaiBanGhi @default(HOAT_DONG) @map("trang_thai")
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  nguoiDung   NguoiDung       @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade, map: "fk_khach_hang_nguoi_dung")

  @@index([trangThai], map: "idx_khach_hang_trang_thai")
  @@map("khach_hang")
}

model NhanVien {
  id          String          @id @default(uuid(7)) @db.Char(36)
  nguoiDungId String          @unique(map: "uk_nhan_vien_nguoi_dung") @map("nguoi_dung_id") @db.Char(36)
  maNhanVien  String          @unique(map: "uk_nhan_vien_ma") @map("ma_nhan_vien") @db.VarChar(50)
  chucDanh    String?         @map("chuc_danh") @db.VarChar(100)
  trangThai   TrangThaiBanGhi @default(HOAT_DONG) @map("trang_thai")
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  nguoiDung   NguoiDung       @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade, map: "fk_nhan_vien_nguoi_dung")

  @@index([trangThai], map: "idx_nhan_vien_trang_thai")
  @@map("nhan_vien")
}

model VaiTro {
  id              String            @id @default(uuid(7)) @db.Char(36)
  ma              String            @unique(map: "uk_vai_tro_ma") @db.VarChar(50)
  ten             String            @db.VarChar(100)
  moTa            String?           @map("mo_ta") @db.VarChar(255)
  trangThai       TrangThaiBanGhi   @default(HOAT_DONG) @map("trang_thai")
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  vaiTroQuyen     VaiTroQuyen[]
  nguoiDungVaiTro NguoiDungVaiTro[]

  @@index([trangThai], map: "idx_vai_tro_trang_thai")
  @@map("vai_tro")
}

model Quyen {
  id          String          @id @default(uuid(7)) @db.Char(36)
  ma          String          @unique(map: "uk_quyen_ma") @db.VarChar(100)
  ten         String          @db.VarChar(150)
  moTa        String?         @map("mo_ta") @db.VarChar(255)
  trangThai   TrangThaiBanGhi @default(HOAT_DONG) @map("trang_thai")
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  vaiTroQuyen VaiTroQuyen[]

  @@index([trangThai], map: "idx_quyen_trang_thai")
  @@map("quyen")
}

model VaiTroQuyen {
  id        String          @id @default(uuid(7)) @db.Char(36)
  vaiTroId  String          @map("vai_tro_id") @db.Char(36)
  quyenId   String          @map("quyen_id") @db.Char(36)
  trangThai TrangThaiBanGhi @default(HOAT_DONG) @map("trang_thai")
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  vaiTro    VaiTro          @relation(fields: [vaiTroId], references: [id], onDelete: Cascade, map: "fk_vai_tro_quyen_vai_tro")
  quyen     Quyen           @relation(fields: [quyenId], references: [id], onDelete: Cascade, map: "fk_vai_tro_quyen_quyen")

  @@unique([vaiTroId, quyenId], map: "uk_vai_tro_quyen")
  @@index([quyenId], map: "idx_vai_tro_quyen_quyen")
  @@index([trangThai], map: "idx_vai_tro_quyen_trang_thai")
  @@map("vai_tro_quyen")
}

model NguoiDungVaiTro {
  id          String          @id @default(uuid(7)) @db.Char(36)
  nguoiDungId String          @map("nguoi_dung_id") @db.Char(36)
  vaiTroId    String          @map("vai_tro_id") @db.Char(36)
  trangThai   TrangThaiBanGhi @default(HOAT_DONG) @map("trang_thai")
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  nguoiDung   NguoiDung       @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade, map: "fk_nguoi_dung_vai_tro_nguoi_dung")
  vaiTro      VaiTro          @relation(fields: [vaiTroId], references: [id], onDelete: Cascade, map: "fk_nguoi_dung_vai_tro_vai_tro")

  @@unique([nguoiDungId, vaiTroId], map: "uk_nguoi_dung_vai_tro")
  @@index([vaiTroId], map: "idx_nguoi_dung_vai_tro_vai_tro")
  @@index([trangThai], map: "idx_nguoi_dung_vai_tro_trang_thai")
  @@map("nguoi_dung_vai_tro")
}

model DiaChi {
  id           String          @id @default(uuid(7)) @db.Char(36)
  nguoiDungId  String          @map("nguoi_dung_id") @db.Char(36)
  tenNguoiNhan String          @map("ten_nguoi_nhan") @db.VarChar(150)
  soDienThoai  String          @map("so_dien_thoai") @db.VarChar(20)
  dongDiaChi   String          @map("dong_dia_chi") @db.VarChar(255)
  phuongXa     String?         @map("phuong_xa") @db.VarChar(120)
  quanHuyen    String?         @map("quan_huyen") @db.VarChar(120)
  tinhThanh    String          @map("tinh_thanh") @db.VarChar(120)
  maBuuChinh   String?         @map("ma_buu_chinh") @db.VarChar(20)
  macDinh      Boolean         @default(false) @map("mac_dinh")
  trangThai    TrangThaiBanGhi @default(HOAT_DONG) @map("trang_thai")
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  nguoiDung    NguoiDung       @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade, map: "fk_dia_chi_nguoi_dung")

  @@index([nguoiDungId, macDinh], map: "idx_dia_chi_nguoi_dung_mac_dinh")
  @@index([trangThai], map: "idx_dia_chi_trang_thai")
  @@map("dia_chi")
}

model PhienDangNhap {
  id               String    @id @default(uuid(7)) @db.Char(36)
  nguoiDungId      String    @map("nguoi_dung_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  hetHanLuc        DateTime  @map("het_han_luc") @db.DateTime(3)
  thuHoiLuc        DateTime? @map("thu_hoi_luc") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  nguoiDung        NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade, map: "fk_phien_dang_nhap_nguoi_dung")

  @@index([nguoiDungId, thuHoiLuc], map: "idx_phien_dang_nhap_nguoi_dung")
  @@index([hetHanLuc], map: "idx_phien_dang_nhap_het_han")
  @@map("phien_dang_nhap")
}

model YeuCauDatLaiMatKhau {
  id          String    @id @default(uuid(7)) @db.Char(36)
  nguoiDungId String    @map("nguoi_dung_id") @db.Char(36)
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  hetHanLuc   DateTime  @map("het_han_luc") @db.DateTime(3)
  daDungLuc   DateTime? @map("da_dung_luc") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade, map: "fk_yeu_cau_dat_lai_mat_khau_nguoi_dung")

  @@index([nguoiDungId, daDungLuc], map: "idx_dat_lai_mat_khau_nguoi_dung")
  @@index([hetHanLuc], map: "idx_dat_lai_mat_khau_het_han")
  @@map("yeu_cau_dat_lai_mat_khau")
}

model NhatKyKiemToan {
  id        String   @id @default(uuid(7)) @db.Char(36)
  tacNhanId String?  @map("tac_nhan_id") @db.Char(36)
  tacNhan   String   @map("tac_nhan") @db.VarChar(191)
  hanhDong  String   @map("hanh_dong") @db.VarChar(100)
  thucThe   String   @map("thuc_the") @db.VarChar(100)
  thucTheId String?  @map("thuc_the_id") @db.VarChar(64)
  truoc     Json?    @map("truoc")
  sau       Json?    @map("sau")
  metadata  Json?    @map("metadata")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([tacNhanId, createdAt], map: "idx_audit_tac_nhan_thoi_gian")
  @@index([hanhDong, createdAt], map: "idx_audit_hanh_dong_thoi_gian")
  @@index([thucThe, thucTheId, createdAt], map: "idx_audit_thuc_the_thoi_gian")
  @@index([createdAt], map: "idx_audit_thoi_gian")
  @@map("nhat_ky_kiem_toan")
}

model TepTin {
  id                   String                 @id @default(uuid(7)) @db.Char(36)
  bucket               String                 @db.VarChar(63)
  objectKey            String                 @unique(map: "uk_tep_tin_object_key") @map("object_key") @db.VarChar(512)
  tenGoc               String                 @map("ten_goc") @db.VarChar(255)
  mimeType             String                 @map("mime_type") @db.VarChar(100)
  kichThuoc            BigInt                 @map("kich_thuoc") @db.UnsignedBigInt
  sha256               String                 @db.Char(64)
  nguoiTaiLenId        String                 @map("nguoi_tai_len_id") @db.Char(36)
  nguoiTaiLen          String                 @map("nguoi_tai_len") @db.VarChar(191)
  trangThai            TrangThaiBanGhi        @default(HOAT_DONG) @map("trang_thai")
  xoaLuc               DateTime?              @map("xoa_luc") @db.DateTime(3)
  createdAt            DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  anhTrangTrai         TrangTraiAnh[]
  chungNhan            ChungNhan[]
  anhKiemDinhChatLuong KiemDinhChatLuongAnh[]

  @@index([nguoiTaiLenId, createdAt], map: "idx_tep_tin_nguoi_tai_len")
  @@index([sha256], map: "idx_tep_tin_sha256")
  @@index([trangThai, createdAt], map: "idx_tep_tin_trang_thai")
  @@map("tep_tin")
}

model NhaCungCap {
  id           String          @id @default(uuid(7)) @db.Char(36)
  ma           String          @unique(map: "uk_nha_cung_cap_ma") @db.VarChar(50)
  ten          String          @db.VarChar(200)
  nguoiDaiDien String?         @map("nguoi_dai_dien") @db.VarChar(150)
  soDienThoai  String?         @map("so_dien_thoai") @db.VarChar(20)
  email        String?         @db.VarChar(191)
  diaChi       String?         @map("dia_chi") @db.VarChar(500)
  ghiChu       String?         @map("ghi_chu") @db.Text
  trangThai    TrangThaiBanGhi @default(HOAT_DONG) @map("trang_thai")
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  trangTrai    TrangTrai[]

  @@index([ten], map: "idx_nha_cung_cap_ten")
  @@index([trangThai, createdAt], map: "idx_nha_cung_cap_trang_thai")
  @@map("nha_cung_cap")
}

model TrangTrai {
  id           String          @id @default(uuid(7)) @db.Char(36)
  ma           String          @unique(map: "uk_trang_trai_ma") @db.VarChar(50)
  ten          String          @db.VarChar(200)
  diaChi       String          @map("dia_chi") @db.VarChar(500)
  viDo         Decimal?        @map("vi_do") @db.Decimal(9, 6)
  kinhDo       Decimal?        @map("kinh_do") @db.Decimal(9, 6)
  dienTichHa   Decimal?        @map("dien_tich_ha") @db.Decimal(12, 2)
  nhaCungCapId String          @map("nha_cung_cap_id") @db.Char(36)
  trangThai    TrangThaiBanGhi @default(HOAT_DONG) @map("trang_thai")
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  nhaCungCap   NhaCungCap      @relation(fields: [nhaCungCapId], references: [id], onDelete: Restrict, map: "fk_trang_trai_nha_cung_cap")
  anh          TrangTraiAnh[]
  chungNhan    ChungNhan[]
  muaVu        MuaVu[]

  @@index([ten], map: "idx_trang_trai_ten")
  @@index([nhaCungCapId, trangThai], map: "idx_trang_trai_nha_cung_cap")
  @@index([trangThai, createdAt], map: "idx_trang_trai_trang_thai")
  @@map("trang_trai")
}

model TrangTraiAnh {
  id          String    @id @default(uuid(7)) @db.Char(36)
  trangTraiId String    @map("trang_trai_id") @db.Char(36)
  tepTinId    String    @map("tep_tin_id") @db.Char(36)
  thuTu       Int       @default(0) @map("thu_tu") @db.UnsignedSmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  trangTrai   TrangTrai @relation(fields: [trangTraiId], references: [id], onDelete: Cascade, map: "fk_trang_trai_anh_trang_trai")
  tepTin      TepTin    @relation(fields: [tepTinId], references: [id], onDelete: Restrict, map: "fk_trang_trai_anh_tep_tin")

  @@unique([trangTraiId, tepTinId], map: "uk_trang_trai_anh")
  @@index([tepTinId], map: "idx_trang_trai_anh_tep_tin")
  @@index([trangTraiId, thuTu], map: "idx_trang_trai_anh_thu_tu")
  @@map("trang_trai_anh")
}

model ChungNhan {
  id               String                    @id @default(uuid(7)) @db.Char(36)
  trangTraiId      String                    @map("trang_trai_id") @db.Char(36)
  loai             String                    @db.VarChar(100)
  ma               String                    @unique(map: "uk_chung_nhan_ma") @db.VarChar(100)
  donViCap         String                    @map("don_vi_cap") @db.VarChar(200)
  ngayCap          DateTime                  @map("ngay_cap") @db.Date
  ngayHetHan       DateTime                  @map("ngay_het_han") @db.Date
  tepTinId         String                    @map("tep_tin_id") @db.Char(36)
  trangThaiXacMinh TrangThaiXacMinhChungNhan @default(CHO_XAC_MINH) @map("trang_thai_xac_minh")
  lyDoTuChoi       String?                   @map("ly_do_tu_choi") @db.VarChar(500)
  xacMinhLuc       DateTime?                 @map("xac_minh_luc") @db.DateTime(3)
  canhBao30NgayLuc DateTime?                 @map("canh_bao_30_ngay_luc") @db.DateTime(3)
  canhBao7NgayLuc  DateTime?                 @map("canh_bao_7_ngay_luc") @db.DateTime(3)
  canhBaoHetHanLuc DateTime?                 @map("canh_bao_het_han_luc") @db.DateTime(3)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  trangTrai        TrangTrai                 @relation(fields: [trangTraiId], references: [id], onDelete: Restrict, map: "fk_chung_nhan_trang_trai")
  tepTin           TepTin                    @relation(fields: [tepTinId], references: [id], onDelete: Restrict, map: "fk_chung_nhan_tep_tin")

  @@index([trangTraiId, trangThaiXacMinh], map: "idx_chung_nhan_trang_trai")
  @@index([trangThaiXacMinh, ngayHetHan], map: "idx_chung_nhan_xac_minh_het_han")
  @@index([ngayHetHan], map: "idx_chung_nhan_ngay_het_han")
  @@index([tepTinId], map: "idx_chung_nhan_tep_tin")
  @@map("chung_nhan")
}

model MuaVu {
  id                 String          @id @default(uuid(7)) @db.Char(36)
  trangTraiId        String          @map("trang_trai_id") @db.Char(36)
  cayTrong           String          @map("cay_trong") @db.VarChar(150)
  giong              String          @db.VarChar(150)
  ngayTrong          DateTime        @map("ngay_trong") @db.Date
  ngayDuKienThuHoach DateTime        @map("ngay_du_kien_thu_hoach") @db.Date
  sanLuongDuKienKg   Decimal         @map("san_luong_du_kien_kg") @db.Decimal(14, 3)
  trangThai          TrangThaiMuaVu  @default(KE_HOACH) @map("trang_thai")
  createdAt          DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  trangTrai          TrangTrai       @relation(fields: [trangTraiId], references: [id], onDelete: Restrict, map: "fk_mua_vu_trang_trai")
  nhatKyCanhTac      NhatKyCanhTac[]
  thuHoach           ThuHoach[]

  @@index([trangTraiId, trangThai], map: "idx_mua_vu_trang_trai_trang_thai")
  @@index([cayTrong, giong], map: "idx_mua_vu_cay_trong_giong")
  @@index([trangThai, ngayDuKienThuHoach], map: "idx_mua_vu_trang_thai_thu_hoach")
  @@index([ngayTrong], map: "idx_mua_vu_ngay_trong")
  @@map("mua_vu")
}

model NhatKyCanhTac {
  id              String            @id @default(uuid(7)) @db.Char(36)
  muaVuId         String            @map("mua_vu_id") @db.Char(36)
  loaiSuKien      LoaiSuKienCanhTac @map("loai_su_kien")
  thoiGian        DateTime          @map("thoi_gian") @db.DateTime(3)
  noiDung         String            @map("noi_dung") @db.Text
  hienThiCongKhai Boolean           @default(false) @map("hien_thi_cong_khai")
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  muaVu           MuaVu             @relation(fields: [muaVuId], references: [id], onDelete: Restrict, map: "fk_nhat_ky_canh_tac_mua_vu")

  @@index([muaVuId, thoiGian], map: "idx_nhat_ky_canh_tac_mua_vu_thoi_gian")
  @@index([loaiSuKien, thoiGian], map: "idx_nhat_ky_canh_tac_loai_thoi_gian")
  @@index([hienThiCongKhai, thoiGian], map: "idx_nhat_ky_canh_tac_cong_khai_thoi_gian")
  @@map("nhat_ky_canh_tac")
}

model ThuHoach {
  id           String      @id @default(uuid(7)) @db.Char(36)
  muaVuId      String      @map("mua_vu_id") @db.Char(36)
  ngayThuHoach DateTime    @map("ngay_thu_hoach") @db.Date
  soLuong      Decimal     @map("so_luong") @db.Decimal(14, 3)
  donVi        String      @map("don_vi") @db.VarChar(30)
  phanLoai     String      @map("phan_loai") @db.VarChar(100)
  ghiChu       String?     @map("ghi_chu") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  muaVu        MuaVu       @relation(fields: [muaVuId], references: [id], onDelete: Restrict, map: "fk_thu_hoach_mua_vu")
  loSanPham    LoSanPham[]

  @@index([muaVuId, ngayThuHoach], map: "idx_thu_hoach_mua_vu_ngay")
  @@index([phanLoai, ngayThuHoach], map: "idx_thu_hoach_phan_loai_ngay")
  @@index([donVi], map: "idx_thu_hoach_don_vi")
  @@map("thu_hoach")
}

model LoSanPham {
  id                String              @id @default(uuid(7)) @db.Char(36)
  maLo              String              @unique(map: "uk_lo_san_pham_ma_lo") @map("ma_lo") @db.VarChar(100)
  thuHoachId        String              @map("thu_hoach_id") @db.Char(36)
  soLuong           Decimal             @map("so_luong") @db.Decimal(14, 3)
  conLai            Decimal             @map("con_lai") @db.Decimal(14, 3)
  phanHangChatLuong String?             @map("phan_hang_chat_luong") @db.VarChar(100)
  ngayHetHan        DateTime            @map("ngay_het_han") @db.Date
  trangThai         TrangThaiLoSanPham  @default(MOI_TAO) @map("trang_thai")
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  maTruyXuat        String?             @unique(map: "uk_lo_san_pham_ma_truy_xuat") @map("ma_truy_xuat") @db.VarChar(40)
  thuHoach          ThuHoach            @relation(fields: [thuHoachId], references: [id], onDelete: Restrict, map: "fk_lo_san_pham_thu_hoach")
  kiemDinhChatLuong KiemDinhChatLuong[]

  @@index([thuHoachId, trangThai], map: "idx_lo_san_pham_thu_hoach_trang_thai")
  @@index([trangThai, ngayHetHan], map: "idx_lo_san_pham_trang_thai_het_han")
  @@index([phanHangChatLuong], map: "idx_lo_san_pham_phan_hang")
  @@map("lo_san_pham")
}

model KiemDinhChatLuong {
  id              String                  @id @default(uuid(7)) @db.Char(36)
  loSanPhamId     String                  @map("lo_san_pham_id") @db.Char(36)
  ngayKiemDinh    DateTime                @map("ngay_kiem_dinh") @db.Date
  nguoiKiemDinhId String                  @map("nguoi_kiem_dinh_id") @db.Char(36)
  ketQua          KetQuaKiemDinhChatLuong @map("ket_qua")
  phanHang        String?                 @map("phan_hang") @db.VarChar(100)
  ghiChu          String?                 @map("ghi_chu") @db.Text
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  loSanPham       LoSanPham               @relation(fields: [loSanPhamId], references: [id], onDelete: Restrict, map: "fk_kiem_dinh_chat_luong_lo")
  nguoiKiemDinh   NguoiDung               @relation(fields: [nguoiKiemDinhId], references: [id], onDelete: Restrict, map: "fk_kiem_dinh_chat_luong_nguoi_dung")
  anh             KiemDinhChatLuongAnh[]

  @@index([loSanPhamId, ngayKiemDinh], map: "idx_kiem_dinh_chat_luong_lo_ngay")
  @@index([ketQua, ngayKiemDinh], map: "idx_kiem_dinh_chat_luong_ket_qua_ngay")
  @@index([nguoiKiemDinhId, ngayKiemDinh], map: "idx_kiem_dinh_chat_luong_nguoi_ngay")
  @@map("kiem_dinh_chat_luong")
}

model KiemDinhChatLuongAnh {
  id                  String            @id @default(uuid(7)) @db.Char(36)
  kiemDinhChatLuongId String            @map("kiem_dinh_chat_luong_id") @db.Char(36)
  tepTinId            String            @map("tep_tin_id") @db.Char(36)
  thuTu               Int               @default(0) @map("thu_tu") @db.UnsignedSmallInt
  createdAt           DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  kiemDinhChatLuong   KiemDinhChatLuong @relation(fields: [kiemDinhChatLuongId], references: [id], onDelete: Cascade, map: "fk_kiem_dinh_anh_kiem_dinh")
  tepTin              TepTin            @relation(fields: [tepTinId], references: [id], onDelete: Restrict, map: "fk_kiem_dinh_anh_tep_tin")

  @@unique([kiemDinhChatLuongId, tepTinId], map: "uk_kiem_dinh_chat_luong_anh")
  @@index([tepTinId], map: "idx_kiem_dinh_chat_luong_anh_tep_tin")
  @@index([kiemDinhChatLuongId, thuTu], map: "idx_kiem_dinh_chat_luong_anh_thu_tu")
  @@map("kiem_dinh_chat_luong_anh")
}
