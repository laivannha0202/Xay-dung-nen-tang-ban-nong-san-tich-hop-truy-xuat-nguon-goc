{
  "name": "@agrimarket/api",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "5.58.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "8.0.11",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "prisma generate --config prisma7.config.ts && nest build",
    "start": "prisma generate --config prisma7.config.ts && nest start",
    "start:dev": "prisma generate --config prisma7.config.ts && nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "prisma generate --config prisma7.config.ts && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate --config prisma7.config.ts && NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e": "prisma generate --config prisma7.config.ts && NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "prisma:migrate:status": "prisma migrate status --config prisma7.config.ts"
  }
}
