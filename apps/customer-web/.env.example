# Admin console, used for the "go to admin" link after an admin logs in.
NEXT_PUBLIC_ADMIN_WEB=http://localhost:3001
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# Store identity printed on every chứng từ and in both footers. Leave a line out and it is
# simply not printed — never invent a legal name, address, hotline or tax code.
NEXT_PUBLIC_STORE_NAME=AgriMarket
#NEXT_PUBLIC_STORE_LEGAL_NAME=
#NEXT_PUBLIC_STORE_ADDRESS=Thành phố Hưng Yên, tỉnh Hưng Yên
#NEXT_PUBLIC_STORE_HOTLINE=
#NEXT_PUBLIC_STORE_EMAIL=
#NEXT_PUBLIC_STORE_WEBSITE=
#NEXT_PUBLIC_STORE_TAX_CODE=
