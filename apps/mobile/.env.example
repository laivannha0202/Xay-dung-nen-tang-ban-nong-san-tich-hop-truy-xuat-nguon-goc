# AgriMarket Mobile — environment example
#
# Android physical device:
# - Điện thoại và máy Linux phải cùng LAN/Wi-Fi.
# - Thay IP dưới đây bằng IP LAN thật của máy Linux.
EXPO_PUBLIC_API_BASE_URL=http://192.168.100.226:3000

# Android Emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# LƯU Ý:
# - Không dùng 127.0.0.1 trên điện thoại Android thật.
# - EXPO_PUBLIC_* là biến phía client; KHÔNG để secret trong các biến này.
