{
  "name": "@agrimarket/api-client",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "snapshot": "node tools/tai-openapi.mjs",
    "generate": "orval --config ./orval.config.ts",
    "ensure": "node tools/dam-bao-generated.mjs",
    "typecheck": "pnpm run ensure && tsc --noEmit -p tsconfig.json",
    "build": "pnpm run typecheck",
    "smoke": "pnpm run ensure && tsx tools/kiem-tra-suc-khoe.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5 <6",
    "react": ">=19 <20"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.102.8",
    "@types/node": "24.13.3",
    "orval": "8.26.0",
    "react": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
