  "info": {
    "title": "AgriMarket API",
    "description": "REST API dùng chung cho hệ thống AgriMarket",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "PhanHoiSucKhoeDto": {
        "type": "object",
        "properties": {
          "trangThai": {
            "type": "string",
            "example": "ok",
            "description": "Trạng thái hiện tại của API"
          },
          "dichVu": {
            "type": "string",
            "example": "agrimarket-api",
            "description": "Tên dịch vụ đang phản hồi"
          }
        },
        "required": ["trangThai", "dichVu"]
      },
      "PhanQuyenNguoiDungDto": {
        "type": "object",
        "properties": {
          "nguoiDungId": {
            "type": "string"
          },
          "vaiTro": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quyen": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["nguoiDungId", "vaiTro", "quyen"]
      },
      "GanVaiTroDto": {
        "type": "object",
        "properties": {
          "nguoiDungId": {
            "type": "string"
          },
          "maVaiTro": {
            "type": "string",
            "enum": ["KHACH_HANG", "NHAN_VIEN", "ADMIN"]
          }
        },
        "required": ["nguoiDungId", "maVaiTro"]
      },
      "PhanHoiGanVaiTroDto": {
        "type": "object",
        "properties": {
          "nguoiDungId": {
            "type": "string"
          },
          "maVaiTro": {
            "type": "string"
          },
          "thongBao": {
            "type": "string"
          }
        },
        "required": ["nguoiDungId", "maVaiTro", "thongBao"]
      },
      "DangKyDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "khachhang@example.com"
          },
          "matKhau": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "hoTen": {
            "type": "string",
            "example": "Nguyễn Văn A"
          },
          "soDienThoai": {
            "type": "string",
            "example": "0912345678"
          }
        },
        "required": ["email", "matKhau", "hoTen"]
      },
      "NguoiDungXacThucDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "hoTen": {
            "type": "string"
          }
        },
        "required": ["id", "email", "hoTen"]
      },
      "PhanHoiDangKyDto": {
        "type": "object",
        "properties": {
          "nguoiDung": {
            "$ref": "#/components/schemas/NguoiDungXacThucDto"
          }
        },
        "required": ["nguoiDung"]
      },
      "DangNhapDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "khachhang@example.com"
          },
          "matKhau": {
            "type": "string"
          },
          "nenTang": {
            "type": "string",
            "enum": ["WEB", "MOBILE"],
            "default": "WEB"
          }
        },
        "required": ["email", "matKhau", "nenTang"]
      },
      "PhanHoiTokenDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Chỉ trả cho client MOBILE; WEB dùng HttpOnly cookie."
          },
          "nguoiDung": {
            "$ref": "#/components/schemas/NguoiDungXacThucDto"
          }
        },
        "required": ["accessToken", "expiresIn", "nguoiDung"]
      },
      "LamMoiTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Mobile gửi refresh token trong body; Web dùng HttpOnly cookie."
          },
          "nenTang": {
            "type": "string",
            "enum": ["WEB", "MOBILE"],
            "default": "WEB"
          }
        }
      },
      "PhanHoiThongBaoDto": {
        "type": "object",
        "properties": {
          "thongBao": {
            "type": "string"
          }
        },
