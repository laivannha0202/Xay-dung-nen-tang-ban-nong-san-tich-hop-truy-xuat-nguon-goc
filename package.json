{
  "name": "agrimarket",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api-client:snapshot": "pnpm --filter @agrimarket/api-client snapshot",
    "api-client:generate": "pnpm --filter @agrimarket/api-client generate",
    "api-client:ensure": "pnpm --filter @agrimarket/api-client ensure",
    "api-client:sync": "node tools/api-client-sync.mjs",
    "dev:customer": "node tools/dev-stack.mjs customer",
    "dev": "node tools/dev-stack.mjs all",
    "db:seed:demo": "pnpm --filter @agrimarket/api-client exec tsx ../../apps/api/scripts/seed-data.ts",
    "db:seed:dia-ban-hung-yen": "pnpm --filter @agrimarket/api-client exec tsx ../../apps/api/scripts/seed-dia-ban-hung-yen.ts",
    "demo:smoke": "node scripts/smoke-demo.mjs",
    "runtime:smoke": "node tools/runtime-smoke.mjs",
    "release:gate": "node tools/release-gate.mjs",
    "release:final": "pnpm api-client:sync && pnpm release:gate",
    "dev:all": "node tools/dev-stack.mjs all",
    "dev:web": "node tools/dev-stack.mjs web",
    "dev:api": "node tools/dev-stack.mjs api",
    "dev:admin": "node tools/dev-stack.mjs admin",
    "dev:mobile": "node tools/dev-stack.mjs mobile",
    "doctor": "node tools/doctor.mjs",
    "cleanup:e2e-public": "pnpm --filter @agrimarket/api-client exec tsx ../../apps/api/scripts/cleanup-e2e-public-fixtures.ts",
    "commerce:smoke": "node tools/ecommerce-runtime-v6.mjs"
  },
  "devDependencies": {
    "@agrimarket/eslint-config": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
