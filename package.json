{
  "name": "agrimarket",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:migrate": "pnpm --filter @agrimarket/api migrate",
    "db:seed": "pnpm --filter @agrimarket/api seed",
    "api": "pnpm --filter @agrimarket/api dev",
    "admin": "pnpm --filter @agrimarket/admin-web dev",
    "shop": "pnpm --filter @agrimarket/customer-web dev",
    "mobile": "pnpm --filter @agrimarket/mobile start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @agrimarket/api test",
    "build": "pnpm -r build",
    "verify:local": "node apps/api/scripts/verify-local.mjs",
    "e2e:local": "node apps/api/scripts/e2e-local.mjs",
    "acceptance": "node scripts/acceptance-walk.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "playwright-core": "^1.65.1"
  }
}
