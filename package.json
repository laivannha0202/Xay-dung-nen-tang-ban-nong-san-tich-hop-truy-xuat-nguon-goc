{
  "name": "agrimarket",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --filter './apps/**' --filter './packages/**' --if-present run typecheck",
    "test": "pnpm -r --filter './apps/**' --filter './packages/**' --if-present run test",
    "build": "pnpm -r --filter './apps/**' --filter './packages/**' --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f",
    "api-client:snapshot": "pnpm --filter @agrimarket/api-client snapshot",
    "api-client:generate": "pnpm --filter @agrimarket/api-client generate",
    "api-client:ensure": "pnpm --filter @agrimarket/api-client ensure"
  },
  "devDependencies": {
    "@agrimarket/eslint-config": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
